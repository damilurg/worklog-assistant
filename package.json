{
  "name": "worklog-assistant",
  "author": "damilurg",
  "version": "1.0.0",
  "description": "GitLab to Jira Worklog Assistant",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "gitlab": "node apps/cli/dist/index.js gitlab sync",
    "jira": "node apps/cli/dist/index.js jira sync",
    "sync": "node apps/cli/dist/index.js sync",
    "standup": "node apps/cli/dist/index.js report",
    "report": "node apps/cli/dist/index.js export --sync --format csv --output worklogs.csv",
    "report:json": "node apps/cli/dist/index.js export --sync --format json --output worklogs.json",
    "finish": "node apps/cli/dist/index.js finish",
    "get:report": "node apps/cli/dist/index.js finish --only report",
    "get:standup": "node apps/cli/dist/index.js finish --only standup",
    "activity": "node apps/cli/dist/index.js activity",
    "day": "node apps/cli/dist/index.js day",
    "graph": "pnpm build && node apps/api/dist/index.js",
    "graph:demo": "pnpm build && node apps/api/dist/index.js --demo",
    "graph:dev": "pnpm --filter @worklog-assistant/web start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.4",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.1"
  },
  "packageManager": "pnpm@11.25.0"
}
