DATABASE_URL=postgresql://postgres:postgres@localhost:5432/worklogs
GITLAB_INSTANCES=[{"url":"https://gitlab.example.com","token":"your_gitlab_token","projectIds":[123,456]}]
GITLAB_AUTHOR_EMAILS=your.email@example.com,another.email@example.com
GITLAB_AUTHOR_NAMES=your_username,Another_Name
JIRA_URL=https://jira.example.com
JIRA_EMAIL=your_jira_email@example.com
JIRA_TOKEN=your_jira_token
JIRA_AUTH_MODE=cloud
WORKDAY_HOURS=8
TIMEZONE=Asia/Bishkek

# Graph projection; GitLab/Jira credentials above are reused by the existing CLI
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=worklog_graph
